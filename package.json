{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "bin": {
    "factory": "dist/src/cli/factory.js",
    "factoryd": "dist/src/cli/factoryd.js",
    "factory-guard": "dist/src/cli/guard.js"
  },
  "scripts": {
    "schema:generate": "node scripts/schema.ts",
    "schema:check": "node scripts/schema.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/*.integration.test.js",
    "test:docker:checks": "npm run build && node --test dist/scripts/check-boundary-docker.js",
    "test:live": "npm run build && node dist/scripts/live.js",
    "check": "npm run schema:check && npm run typecheck && npm run lint && npm run format:check && npm test",
    "worktree": "node dist/scripts/worktree.js",
    "test:worktree": "npm run build && node --test dist/tests/worktree.integration.test.js"
  },
  "dependencies": {
    "@openai/codex": "0.162.0",
    "@openai/codex-sdk": "0.162.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "openai": "7.31.0",
    "pino": "10.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
